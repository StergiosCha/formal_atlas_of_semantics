{
  "endpoint_env": "AZURE_AI_ENDPOINT",
  "key_env": "AZURE_AI_KEY",
  "default_endpoint": "https://crete-xamoulis-resource.services.ai.azure.com",
  "api_version": "2024-05-01-preview",
  "roster": [
    {"deployment": "claude-opus-5",  "family": "anthropic", "role": "drafter"},
    {"deployment": "claude-fable-5", "family": "anthropic", "role": "drafter"},
    {"deployment": "gpt-5.6-sol",    "family": "openai",    "role": "drafter"},
    {"deployment": "gpt-5.5",        "family": "openai",    "role": "drafter"},
    {"deployment": "grok-4.3",       "family": "xai",       "role": "drafter"},
    {"deployment": "DeepSeek-V4-Pro","family": "deepseek",  "role": "drafter"},
    {"deployment": "Kimi-K2.6",      "family": "moonshot",  "role": "drafter"},
    {"deployment": "gpt-5.4-mini",   "family": "openai",    "role": "cheap_first"}
  ],
  "policy": {
    "first_draft": "gpt-5.4-mini",
    "escalate_to": "claude-opus-5",
    "escalate_after_round": 2,
    "max_rounds": 4
  }
